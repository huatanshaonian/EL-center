// el_test.cst —— Tang Primer 20K + Dock（GW2A-LV18PG256C8/I7）
// 引脚依据：Sipeed 官方例程 RGB_lcd/rgb_lcd_4.3inch_colorbar/src/lcd.cst（J5/J6 网络 = RGB LCD 复用脚）、
//           litex-boards sipeed_tang_primer_20k（时钟/按键/LED）、设计笔记 §11.2.1、D1.1 网表 P1/P2/P3。
// 使用这些脚时不要插 40P RGB 屏 FPC（J7）和麦克风阵列 FPC（J15），它们共用同一组 FPGA 引脚。

// ---------------- 时钟 ----------------
IO_LOC  "clk27" H11;
// H11 与 HDMI 的 DDC 脚（F14/F16）同在 2.5V bank：输入按 LVCMOS25 声明（新版 apicula 会检查同 bank 电平一致）
IO_PORT "clk27" IO_TYPE=LVCMOS25 PULL_MODE=NONE BANK_VCCIO=2.5;

// ---------------- 按键（低有效） ----------------
IO_LOC  "btn_run_n" T10;
IO_PORT "btn_run_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "btn_pat_n" T3;
IO_PORT "btn_pat_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

// ---------------- LED（低电平点亮）。L16/L14/N14/N16 在 bank 1（2.5V），按 tang-monitor 实测核对的引脚表用 LVCMOS25 ----------------
// 不用 C13/A13：在高云 EDA 里它们是 READY/DONE 复用脚
IO_LOC  "led_n[0]" L16;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS25 PULL_MODE=UP DRIVE=8 BANK_VCCIO=2.5;
IO_LOC  "led_n[1]" L14;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS25 PULL_MODE=UP DRIVE=8 BANK_VCCIO=2.5;
IO_LOC  "led_n[2]" N14;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS25 PULL_MODE=UP DRIVE=8 BANK_VCCIO=2.5;
IO_LOC  "led_n[3]" N16;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS25 PULL_MODE=UP DRIVE=8 BANK_VCCIO=2.5;

// ---------------- Dock J5 → EL-IF P1（8 路数据，EL-IF D1.3 脚序） ----------------
// J5-5 LD3，6 LD1，7 LD2，8 LD0，9 UD0，10 UD3，11 UD1，12 UD2（球号按 Dock 3714 原理图总图核对）
IO_LOC  "el_ld[3]" L9;
IO_LOC  "el_ld[1]" N8;
IO_LOC  "el_ld[2]" N9;
IO_LOC  "el_ld[0]" N7;
IO_LOC  "el_ud[0]" N6;
IO_LOC  "el_ud[3]" D11;
IO_LOC  "el_ud[1]" A11;
IO_LOC  "el_ud[2]" B11;
IO_PORT "el_ud[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "el_ud[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "el_ud[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "el_ud[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "el_ld[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "el_ld[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "el_ld[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "el_ld[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// ---------------- Dock J6 → EL-IF P2（EL-IF D1.3 脚序） ----------------
// J6-6 VD_HI_N（输入），8 VD_ON_N，9 CP2，10 OE_N，11 CP1，12 S；J6-5、J6-7 不用
IO_LOC  "vd_hi_n" C12;
IO_LOC  "vd_on_n" A14;
IO_LOC  "el_cp2"  B14;
IO_LOC  "oe_n"    A15;
IO_PORT "vd_hi_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "vd_on_n" IO_TYPE=LVCMOS33 PULL_MODE=UP   DRIVE=8;
IO_PORT "el_cp2"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "oe_n"    IO_TYPE=LVCMOS33 PULL_MODE=UP   DRIVE=8;
// J6-11/12（D14/E15）在 Bank 1，与 LED0-3 同 bank，只能声明 LVCMOS25（与 el_hdmi 一致）。
// 按核心板原理图 Bank 1 实际 VCCIO 为 3.3 V，输出仍是 3.3 V；即使为 2.5 V，AHCT245 VIH 2.0 V 也够。
IO_LOC  "el_cp1"  D14;
IO_LOC  "el_s"    E15;
IO_PORT "el_cp1"  IO_TYPE=LVCMOS25 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=2.5;
IO_PORT "el_s"    IO_TYPE=LVCMOS25 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=2.5;

// ---------------- Dock J14 → EL-IF P3（状态输入，EL-IF D1.3 脚序） ----------------
// J14-8 VD_FLT_N，9 VL_FLT_N，10 VL_OK，12 PFAIL_N；J14-5/11 是 UART、J14-7 是 SCR_EN（本程序不用）；J14-6 不用（WS2812）
// 面包板阶段这些脚悬空：内部上拉读作 1 = 正常。上 PCB 后由板上上拉电阻决定。
IO_LOC  "vd_flt_n" P8;
IO_LOC  "vl_flt_n" R8;
IO_LOC  "vl_ok"    T7;
IO_LOC  "pfail_n"  P6;
IO_PORT "vl_flt_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "pfail_n"  IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "vl_ok"    IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "vd_flt_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
