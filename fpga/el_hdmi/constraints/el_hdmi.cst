// el_hdmi.cst —— Tang Primer 20K + Dock（GW2A-LV18PG256C8/I7），开源工具链（nextpnr-himbaechel）
// 依据：tang-monitor docs/pinmap.md（在同款 Dock 上实测核对）、D1.1 网表 P1/P2/P3、设计笔记 §11.2.1。
// 使用时不要插 40P RGB 屏 FPC（J7）、麦克风阵列 FPC（J15）、DVP 摄像头（与 DDC 共用 I2C）。

// ---------------- 时钟 ----------------
IO_LOC  "clk27" H11;
// H11 与 HDMI 的 DDC 脚（F14/F16）同在 2.5V bank：输入按 LVCMOS25 声明（新版 apicula 会检查同 bank 电平一致）
IO_PORT "clk27" IO_TYPE=LVCMOS25 PULL_MODE=NONE BANK_VCCIO=2.5;

// ---------------- 按键（低有效） ----------------
IO_LOC  "btn_run_n" T10;
IO_PORT "btn_run_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "btn_src_n" T3;
IO_PORT "btn_src_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
IO_LOC  "btn_hpd_n" T2;
IO_PORT "btn_hpd_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

// ---------------- LED（低电平点亮）。LED0-3 在 bank 1（2.5V），LED4-5 在 bank 3（3.3V） ----------------
IO_LOC  "led_n[0]" L16;
IO_LOC  "led_n[1]" L14;
IO_LOC  "led_n[2]" N14;
IO_LOC  "led_n[3]" N16;
IO_LOC  "led_n[4]" A13;
IO_LOC  "led_n[5]" C13;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS25 PULL_MODE=UP DRIVE=8 BANK_VCCIO=2.5;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS25 PULL_MODE=UP DRIVE=8 BANK_VCCIO=2.5;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS25 PULL_MODE=UP DRIVE=8 BANK_VCCIO=2.5;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS25 PULL_MODE=UP DRIVE=8 BANK_VCCIO=2.5;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// ---------------- Dock J5 → EL-IF P1（8 路数据，EL-IF D1.3 脚序） ----------------
// J5-5 LD3，6 LD1，7 LD2，8 LD0，9 UD0，10 UD3，11 UD1，12 UD2（球号按 Dock 3714 原理图总图核对）
IO_LOC  "el_ld[3]" L9;
IO_LOC  "el_ld[1]" N8;
IO_LOC  "el_ld[2]" N9;
IO_LOC  "el_ld[0]" N7;
IO_LOC  "el_ud[0]" N6;
IO_LOC  "el_ud[3]" D11;
IO_LOC  "el_ud[1]" A11;
IO_LOC  "el_ud[2]" B11;
IO_PORT "el_ud[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "el_ud[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "el_ud[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "el_ud[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "el_ld[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "el_ld[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "el_ld[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "el_ld[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ---------------- Dock J6 → EL-IF P2（EL-IF D1.3 脚序） ----------------
// J6-6 VD_HI_N（输入），8 VD_ON_N，9 CP2，10 OE_N，11 CP1，12 S；J6-5、J6-7 不用
IO_LOC  "vd_hi_n" C12;
IO_LOC  "vd_on_n" A14;
IO_LOC  "el_cp2"  B14;
IO_LOC  "oe_n"    A15;
IO_PORT "vd_hi_n" IO_TYPE=LVCMOS33 PULL_MODE=UP   BANK_VCCIO=3.3;
IO_PORT "vd_on_n" IO_TYPE=LVCMOS33 PULL_MODE=UP   DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "el_cp2"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "oe_n"    IO_TYPE=LVCMOS33 PULL_MODE=UP   DRIVE=8 BANK_VCCIO=3.3;
// J6-11/12（D14/E15）在 Bank 1，与 HDMI LVDS25 输入、LED0-3 同 bank，只能声明 LVCMOS25。
// 按核心板原理图 Bank 1 实际 VCCIO 为 3.3 V（R5 0 Ω），输出仍是 3.3 V；即使为 2.5 V，AHCT245 VIH 2.0 V 也够。
IO_LOC  "el_cp1"  D14;
IO_LOC  "el_s"    E15;
IO_PORT "el_cp1"  IO_TYPE=LVCMOS25 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=2.5;
IO_PORT "el_s"    IO_TYPE=LVCMOS25 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=2.5;

// ---------------- Dock J14 → EL-IF P3（状态输入 + Orange Pi UART，EL-IF D1.3 脚序） ----------------
// J14-5 UART_TX（FPGA→OPi），7 SCR_EN，8 VD_FLT_N，9 VL_FLT_N，10 VL_OK，11 UART_RX（OPi→FPGA），12 PFAIL_N；
// J14-6 不用（与板载 WS2812 共用）。面包板阶段状态线悬空：内部上拉读作 1 = 正常
IO_LOC  "opi_tx"   P9;
IO_LOC  "scr_en"   T8;
IO_LOC  "vd_flt_n" P8;
IO_LOC  "vl_flt_n" R8;
IO_LOC  "vl_ok"    T7;
IO_LOC  "opi_rx"   T6;
IO_LOC  "pfail_n"  P6;
IO_PORT "opi_tx"   IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
// SCR_EN_3V3：斜面"屏幕"开关（EL-IF 板上 10k 上拉；悬空时内部上拉读作 1 = 允许开屏）
IO_PORT "scr_en"   IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "vd_flt_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "vl_flt_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "vl_ok"    IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "opi_rx"   IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "pfail_n"  IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ---------------- Dock USB 调试串口（BL702，115200 8N1） ----------------
IO_LOC  "dbg_tx" M11;
IO_PORT "dbg_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "dbg_rx" T13;
IO_PORT "dbg_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ---------------- HDMI 接收（bank 0/1，2.5V） ----------------
// DDC：经 Dock 上的 2N7002 电平转换到 5V
IO_LOC  "hdmi_sda" F14;
IO_PORT "hdmi_sda" IO_TYPE=LVCMOS25 PULL_MODE=NONE BANK_VCCIO=2.5;
IO_LOC  "hdmi_scl" F16;
IO_PORT "hdmi_scl" IO_TYPE=LVCMOS25 PULL_MODE=NONE BANK_VCCIO=2.5;
IO_LOC  "hdmi_hpd" J11;
IO_PORT "hdmi_hpd" IO_TYPE=LVCMOS25 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=2.5;
// TMDS：每对的 _p/_n 分成两个端口、各自 IO_TYPE=LVDS25，两脚都下拉（交流耦合输入的共模偏置，tang-monitor 实测方法）
IO_LOC  "tmds_clk_p" G16;
IO_PORT "tmds_clk_p" IO_TYPE=LVDS25 PULL_MODE=DOWN BANK_VCCIO=2.5;
IO_LOC  "tmds_clk_n" H15;
IO_PORT "tmds_clk_n" IO_TYPE=LVDS25 PULL_MODE=DOWN BANK_VCCIO=2.5;
IO_LOC  "tmds_d0_p" H14;
IO_PORT "tmds_d0_p" IO_TYPE=LVDS25 PULL_MODE=DOWN BANK_VCCIO=2.5;
IO_LOC  "tmds_d0_n" H16;
IO_PORT "tmds_d0_n" IO_TYPE=LVDS25 PULL_MODE=DOWN BANK_VCCIO=2.5;
IO_LOC  "tmds_d1_p" J15;
IO_PORT "tmds_d1_p" IO_TYPE=LVDS25 PULL_MODE=DOWN BANK_VCCIO=2.5;
IO_LOC  "tmds_d1_n" K16;
IO_PORT "tmds_d1_n" IO_TYPE=LVDS25 PULL_MODE=DOWN BANK_VCCIO=2.5;
IO_LOC  "tmds_d2_p" K14;
IO_PORT "tmds_d2_p" IO_TYPE=LVDS25 PULL_MODE=DOWN BANK_VCCIO=2.5;
IO_LOC  "tmds_d2_n" K15;
IO_PORT "tmds_d2_n" IO_TYPE=LVDS25 PULL_MODE=DOWN BANK_VCCIO=2.5;
